#!/bin/sh
#  $sysrecipes: mkpkg,v 1.0 2026/11/03 15:41:43 littlefly365 Exp $
set -e

__prog_name="mkpkg"
__prog_version="1.0"

prepare() { :; }
configure() { :; }
build() { :; }
pre_install() { :; }
post_install() { :; }

use_build_dir=0
CWD="$(pwd -P)"
download_command="wget -4 -q"
NPROC="$(nproc)"

main()
{
	while [ $# -gt 0 ]; do
		case "$1" in
		-h|--h|--he|--hel|--help)
			printf "%s\n\n%s\n%s\n%s\n"						\
			"Usage: $__prog_name [OPTION] <pkgname>"				\
			"Options:"								\
			"  -h, --help         Display this help and exit"			\
			"  -V, --version      Output version information and exit"
			exit 0
			;;
		-V|--vers|--versi|--versio|--version)
			printf "%s\n%s\n%s\n%s\n%s\n\n%s\n"					\
			"$__prog_name (sysrecipes) $__prog_version"				\
			"Copyright (C) 2026 littlefly365"					\
			"License GPLv2: GNU GPL version 2 <https://gnu.org/licenses/gpl.html>."	\
			"This is free software: you are free to change and redistribute it."	\
			"There is NO WARRANTY, to the extent permitted by law."			\
			"Written by littlefly365."
			exit 0
			;;
		-*)
			printf "$__prog_name: invalid option '$1'\n%s\n"			\
				"Try '$__prog_name --help' for more information."
			exit 1
			;;
		*)
			break
			;;
		esac
	done

	if [ ! -f /etc/mkpkg.conf ]; then
		printf >&2 "$__prog_name: /etc/mkpkg.conf: No such file or directory.\n"
		exit 1
	fi

	. /etc/mkpkg.conf

	if [ ! -f ./LFSBUILD ]; then
		printf >&2 "$__prog_name: 'LFSBUILD' does not exist in the current directory.\n"
		exit 1
	fi

	. ./LFSBUILD

	if [ -z "${pkgname+x}" ] || [ -z "${pkgver+x}" ] || [ -z "${pkgver+x}" ] || [ -z "${pkgurl+x}" ]; then
		printf >&2 "$__prog_name: the LFSBUILD does not have the enough information.\n"
		exit 1
	fi

	if [ "$HOST_ARCH" != "$arch" ] && [ "$arch" != "all" ]; then
		printf >&2 "$__prog_name: This recipe is not for your architecture.\n"
		exit 1
	fi

	if [ "$pkgname" = "gcc" ] || [ "$pkgname" = "binutils" ]; then
		use_build_dir=1
	fi

	printf "===> Downloading file from $pkgurl\n"

	if ! $download_command "$pkgurl"; then
		printf >&2 "FAIL: cannot download from $pkgurl.\n"
		exit 1
	fi

	file_name="$(basename $pkgurl)"

	case "$file_name" in
		*.tar.gz)
			dir_name="${file_name%.tar.gz}"
		;;
		*.tar.xz)
			dir_name="${file_name%.tar.xz}"
		;;
	esac

	tar xf "$file_name"

	if [ ! -d "$dir_name" ]; then
		dir_name="${pkgname}-${pkgver}"
	fi

	cd "$dir_name"

	prepare

	# CONFIGURE
	case "$configure_style" in
		"configure"|"gnu_configure")
			if [ -z "${configure_script+x}" ]; then
				configure_script="./configure"
			fi

			if [ "$use_build_dir" -ne 0 ]; then
				mkdir -p build && cd build
				configure_script="../configure"
			fi

			$configure_script $configure_args
			break
			;;
		"gmake"|"bmake")
			break
			;;
		"custom")
			configre
			break
			;;
		"meson")
			meson setup build $configure_args
			break
			;;
		*)
			printf >&2 "$__prog_name: unknown configuration type '$configure_style'.\n"
			exit 1
			;;
	esac

	# BUILD
	case "$configure_style" in
		"configure"|"gnu_configure"|"gmake")
			make $build_args
			break
		;;
		"bmake")
			bmake $build_args
			break
		;;
		"custom")
			build
			break
		;;
		"meson")
			ninja $build_args -C build
			break
		;;
	esac

	pre_install

	# INSTALL
	if [ "$pkgname" = "linux" ]; then
		kernel_install
	else
		case "$configure_style" in
			"configure"|"gnu_configure"|"gmake")
				make $install_args install
				break
			;;
			"bmake")
				sudo bmake $install_args install
				break
			;;
			"meson")
				ninja $install_args -C build install
				break
			;;
			"custom")
				_install
				break
			;;
		esac
	fi

	post_install
}

main $@
