pkgname=bash
pkgver=5.3
pkgrel=0
pkgurl="https://ftpmirror.gnu.org/$pkgname/$pkgname-$pkgver.tar.gz"

configure()
{
	./configure 				\
		--prefix=/usr 			\
		--without-bash-malloc		\
		--with-installed-readline	\
		--docdir=/usr/share/doc/bash-5.3
}

build()
{
	make
}

package()
{
	make DESTDIR=$PWD/dest install

	ln -svf bash $PWD/dest/usr/bin/sh
	rm -rf $PWD/dest/usr/share/info

	tar -czvf $pkgname-$pkgver-$pkgrel.tar.gz $PWD/dest
}
