pkgname=coreutils
pkgver=9.12
pkgrel=0
pkgdesc="The basic file, shell and text manipulation utilities"
pkgurl="https://ftp.gnu.org/gnu/coreutils/${pkgname}-${pkgver}.tar.gz"

arch=all
license=GPL-3-or-later
maintainer=littlefly365

configure_style="gnu_configure"
configure_args="--prefix=/usr --with-openssl --build=${CBUILD} --host=${CHOST}"

post_install()
{
	mv /usr/bin/chroot /usr/sbin/chroot
	mv /usr/share/man/man1/chroot.1 /usr/share/man/man8/chroot.8
	sed -i 's/"1"/"8"/' /usr/share/man/man8/chroot.8
}
