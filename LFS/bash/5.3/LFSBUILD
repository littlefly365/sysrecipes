pkgname=bash
pkgver=5.3
pkgrel=0
pkgdesc="The GNU Bourne Again Shell"
pkgurl="https://ftpmirror.gnu.org/bash/bash-9.12.tar.gz"

arch=all
license=GPL-3-or-later
category=shells

pkg_config_type="gnu_configure"
configopts="--prefix=/usr --without-bash-malloc --with-installed-readline \
            --docdir=/usr/share/doc/bash-5.3"

post_install()
{
	ln -svf bash /usr/bin/sh
	rm -rf /usr/share/info
}
