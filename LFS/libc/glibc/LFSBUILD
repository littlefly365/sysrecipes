pkgname=glibc
pkgver=2.44
pkgrel=0
pkgdesc="The GNU C library"
pkgurl="https://ftp.gnu.org/gnu/glibc/${pkgname}-${pkgver}.tar.gz"

arch=all
license=LGPL-2.1
maintainer=littlefly365

configure_style="gnu_configure"
configure_args="--prefix=/usr --disable-gcc-wrapper"

prepare()
{
	patch -Np1 -i ${CWD}/patches/glibc-fhs-1.patch
	patch -Np1 -i ${CWD}/patches/glibc-2.44-upstream_fixes-1.patch
}

# It's needed when upgraded from a prior version
pre_install()
{
	make DESTDIR=$PWD/dest install
	install -Dm dest/usr/lib/*.so.* /usr/lib
}

post_install()
{
	sed '/RTLDLIST=/s@/usr@@g' -i /usr/bin/ldd

	make localedata/install-locales

	install -Dm 644 ${CWD}/files/ld.so.conf /etc/ld.so.conf
	install -Dm 644 ${CWD}/files/nsswitch.conf /etc/nsswitch.conf

	tar xf ${CWD}/files/tzdata2026c.tar.gz

	ZONEINFO=/usr/share/zoneinfo
	mkdir -p ${ZONEINFO}/posix ${ZONEINFO}/right

	for tz in etcetera southamerica northamerica europe africa \
			antarctica asia australasia backward; do
		zic -L /dev/null -d ${ZONEINFO}		${tz}
		zic -L /dev/null -d ${ZONEINFO}/posix	${tz}
		zic -L leapseconds -d ${ZONEINFO}/right	${tz}
	done

	cp zone.tab zone1970.tab iso3166.tab ${ZONEINFO}
	zid -d ${ZONEINFO} -p America/New_York

	unzet ZONEINFO tz
}
